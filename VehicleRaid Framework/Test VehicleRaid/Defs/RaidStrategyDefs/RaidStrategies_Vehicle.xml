<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<RaidStrategyDef>
		<defName>VRF_VehicleAssault123</defName>
		<workerClass>VehicleRaidFramework.RaidStrategyWorker_VehicleAssault</workerClass>
		<label>armored assault</label>
		<description>A coordinated armored assault prioritized on heavy vehicles. This tactical division uses
			specialized logistics to keep tanks fueled and operational during the breach.</description>
		<selectionWeightPerPointsCurve>
			<points>
				<li>(2000, 0)</li>
				<li>(5000, 1.5)</li>
				<li>(15000, 3.0)</li>
			</points>
		</selectionWeightPerPointsCurve>
		<pointsFactorCurve>
			<points>
				<li>(0, 1.0)</li>
			</points>
		</pointsFactorCurve>
		<arrivalTextFriendly>A vehicle division from {0} has arrived to support you!</arrivalTextFriendly>
		<arrivalTextEnemy>An armored assault from {0} is approaching! They are using heavy vehicles to breach your
			defenses.</arrivalTextEnemy>
		<letterLabelEnemy>Armored Assault</letterLabelEnemy>
		<arriveModes>
			<li>EdgeWalkIn</li>
		</arriveModes>

		<modExtensions>
			<li Class="VehicleRaidFramework.VehicleRaidExtension">
				
				<factionDef>Empire</factionDef> <!-- def of the faction that will do the raid -->

				
				<vehicleOptions>
			<li>
				<kindDef>VVE_Bulldog_NPC_Kind</kindDef>
				<weight>30</weight>
				<forceCount>1</forceCount>
				<spawnVehicle>true</spawnVehicle>
				<pawnFollowVehicle>true</pawnFollowVehicle>

				<!-- 
				<colorConfig>
				<mode>Fixed</mode>
				<colorOne>(0.2, 0.2, 0.8)</colorOne>
				<colorTwo>(0.1, 0.1, 0.5)</colorTwo>
				<colorThree>(0.9, 0.9, 0.9)</colorThree>
				<pattern>Tiger</pattern>
				</colorConfig>
				-->


				<colorConfig>
				<mode>Faction</mode>
				<pattern>Woodland</pattern>
				</colorConfig>





				<!-- Optional: define specific pawn kinds per role.
				     If left empty the framework generates crew automatically.
				     Count is capped to the vehicle's slot limit for each role. -->
				<!--
				<driverCrew>
					<li>
						<pawnDef>Empire_Fighter_Cataphract</pawnDef>
						<count>1</count>
					</li>
				</driverCrew>
				<gunnerCrew>
					<li>
						<pawnDef>Empire_Fighter_Janissary</pawnDef>
						<count>2</count>
					</li>
				</gunnerCrew>
				<passengerCrew>
					<li>
						<pawnDef>Empire_Fighter_Janissary</pawnDef>
						<count>3</count>
					</li>
				</passengerCrew>
				-->

				<cargoItems>
			<li>
				<thingDef>Steel</thingDef>
				<count>66~75</count>
			</li>
			<li>
				<thingDef>Chemfuel</thingDef>
				<count>333~500</count>
			</li>
			<li>
				<thingDef>MealSurvivalPack</thingDef>
				<count>5~11</count>
			</li>
			</cargoItems>
			</li>

			<li> <!-- Optional vehicles that also consume raid points. You can add as many vehicles as you want. -->
				<kindDef>VVE_Burya_Kind</kindDef> 
				<isMortar>true</isMortar>
				<weight>5</weight>
				<forceCount>0</forceCount> 
				<spawnVehicle>true</spawnVehicle> 
				<pawnFollowVehicle>true</pawnFollowVehicle>
				<cargoItems>
			<li>
				<thingDef>Chemfuel</thingDef>
				<count>333~666</count>
			</li>
			<li>
				<thingDef>MealSurvivalPack</thingDef>
				<count>5~11</count>
			</li>
			</cargoItems>
			</li>

			<li>
				<kindDef>VVE_MosquitoNPC_Kind</kindDef> 
				<weight>8</weight>
				<forceCount>0</forceCount> 
				<spawnVehicle>true</spawnVehicle> 
				<cargoItems>
			<li>
				<thingDef>Chemfuel</thingDef>
				<count>55~155</count>
			</li>
			<li>
				<thingDef>Steel</thingDef>
				<count>111~222</count>
			</li>
			<li>
				<thingDef>MealSurvivalPack</thingDef>
				<count>5~11</count>
			</li>
			</cargoItems>
			</li>

			<li>
				<kindDef>VVE_Scytheman_Kind</kindDef> <!-- This vehicle is a mortar type, it attacks from a distance, it is important that you have the <isMortar> so that the correct behavior is applied. -->
				<isMortar>true</isMortar>
				<weight>5</weight>
				<forceCount>0</forceCount> 
				<spawnVehicle>true</spawnVehicle> 
				<pawnFollowVehicle>true</pawnFollowVehicle>
				<cargoItems>
			<li>
				<thingDef>Chemfuel</thingDef>
				<count>333~666</count>
			</li>
			<li>
				<thingDef>MealSurvivalPack</thingDef>
				<count>5~11</count>
			</li>
			</cargoItems>
			</li>

			<li>
				<kindDef>VVE_Highwayman_Kind</kindDef>
				<weight>20</weight> 
				<forceCount>1</forceCount>
				<spawnVehicle>false</spawnVehicle> 
				<cargoItems>
			<li>
				<thingDef>Steel</thingDef>
				<count>66~75</count>
			</li>
			<li>
				<thingDef>Chemfuel</thingDef>
				<count>66~75</count>
			</li>
			<li>
				<thingDef>MealSurvivalPack</thingDef>
				<count>5~11</count>
			</li>
			</cargoItems>
			</li>
			</vehicleOptions>

			<infantryPointsFraction>0.7</infantryPointsFraction> <!-- This controls the spawn rate of pawns on foot and in vehicles, ranging from 0.1 to 1. The lower the value, the more raid points the narrator will use on vehicles and the less on foot pawns. It's recommended to keep this value high because multiple vehicles can block the path of those traveling further back. -->

			
			<spawnInfantry>true</spawnInfantry> <!-- This blocks the spawning of pawns that travel on foot. -->

			
			<stayTicks>45000</stayTicks> <!-- How long will the raid stay on the map -->

			
			<forcedPawns> <!-- This forcibly generates pawns that go on foot; these pawns do not consume raid points from the narrator and ignore the <spawnInfantry>. -->
				<li>Empire_Fighter_Cataphract</li>
				<li>Empire_Fighter_Janissary</li>
			</forcedPawns>

			
			<letterLabel>Armored Assault!</letterLabel>
			<letterText>An armored division from {0} is approaching. They are bringing heavy vehicles and infantry
				support!</letterText>

			
			
			</li>
		</modExtensions>
	</RaidStrategyDef>

</Defs>
