<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAddModExtension">
        <xpath>Defs/FactionDef[defName="Empire"]</xpath>
        <value>
          <li Class="VehicleRaidFramework.VehicleMerchantExtension">
            <traderMappers>
              <li>
                <traderKind>Empire_Caravan_TraderGeneral</traderKind>
                <principalVehicle>
                  <kindDef>VVE_BigRig_NPC_Kind</kindDef>
                  <tradeCargo>true</tradeCargo>

                  <!-- 
                    <mode>Fixed</mode>
                    <colorOne>(0.2, 0.2, 0.8)</colorOne>
                    <colorTwo>(0.1, 0.1, 0.5)</colorTwo>
                    <colorThree>(0.9, 0.9, 0.9)</colorThree>
                    <pattern>Tiger</pattern>
                  </colorConfig>
                  -->


                  <colorConfig>
                    <mode>Faction</mode>
                    <pattern>Woodland</pattern>
                  </colorConfig>


                  <cargoItems>
                    <li>
                      <thingDef>Steel</thingDef>
                      <count>150~300</count>
                      <tradeable>false</tradeable>
                    </li>
                    <li>
                      <thingDef>MealSurvivalPack</thingDef>
                      <count>2~5</count>
                      <tradeable>false</tradeable>
                    </li>
                    <li>
                      <thingDef>Chemfuel</thingDef>
                      <count>95~100</count>
                      <tradeable>false</tradeable>
                    </li>
                  </cargoItems>
                </principalVehicle>
                <cargoVehicles>
                  <li>
                    <kindDef>VVE_Bulldog_NPC_Kind</kindDef>
                    <count>0~1</count>
                    <tradeCargo>true</tradeCargo>
                    <cargoItems>
                      <li>
                        <thingDef>Steel</thingDef>
                        <count>300~500</count>
                      </li>
                      <li>
                        <thingDef>MealSurvivalPack</thingDef>
                        <count>2~5</count>
                        <tradeable>false</tradeable>
                      </li>
                      <li>
                        <thingDef>Chemfuel</thingDef>
                        <count>95~100</count>
                        <tradeable>false</tradeable>
                      </li>
                    </cargoItems>
                  </li>
                </cargoVehicles>
                <escortVehicles>
                  <li>
                    <kindDef>VVE_Bulldog_NPC_Kind</kindDef>
                    <count>1</count>
                    <tradeCargo>true</tradeCargo>
                    <cargoItems>
                      <li>
                        <thingDef>Chemfuel</thingDef>
                        <count>55~100</count>
                        <tradeable>false</tradeable>
                      </li>
                      <li>
                        <thingDef>MealSurvivalPack</thingDef>
                        <count>2~5</count>
                        <tradeable>false</tradeable>
                      </li>
                    </cargoItems>
                  </li>
                  <li>
                    <kindDef>VVE_Highwayman_Kind</kindDef>
                    <count>2</count>
                    <tradeCargo>true</tradeCargo>
                    <cargoItems>
                      <li>
                        <thingDef>Steel</thingDef>
                        <count>295~300</count>
                        <tradeable>false</tradeable>
                      </li>
                      <li>
                        <thingDef>MealSurvivalPack</thingDef>
                        <count>2~5</count>
                        <tradeable>false</tradeable>
                      </li>
                    </cargoItems>
                  </li>
                </escortVehicles>
              </li>
            </traderMappers>
          </li>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
