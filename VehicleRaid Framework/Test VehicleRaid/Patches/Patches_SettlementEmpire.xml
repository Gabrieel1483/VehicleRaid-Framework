<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/FactionDef[defName="Empire"]/modExtensions</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/FactionDef[defName="Empire"]</xpath>
            <value>
                <modExtensions />
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="Empire"]/modExtensions</xpath>
        <value>
            <li Class="VehicleRaidFramework.VehicleRaidExtension">

                <vehicleOptions>
                    <li><kindDef>VVE_Bulldog_NPC_Kind</kindDef></li>
                    <li><kindDef>VVE_Highwayman_Kind</kindDef></li>
                    <li><kindDef>VVE_Scytheman_Kind</kindDef></li>
                </vehicleOptions>
            </li>
        </value>
    </Operation>
</Patch>
